# Copy this file to ".env" for local work, and add the same names in Vercel > Settings > Environment Variables.
# The real ".env" file is ignored by Git. NEVER put a secret or service_role key in any of these.

# Supabase > Project Settings > API: the Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys: the PUBLISHABLE key (starts with sb_publishable_) or the older "anon" key.
# These are meant for browsers. The secret / service_role key must never be used here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Your final website address, with https and no slash at the end (used for canonical, sitemap and social tags).
# Leave empty until the domain is known.
VITE_SITE_URL=

# Optional: Google Analytics ID like G-XXXXXXXXXX. Leave empty to keep analytics and the cookie banner OFF.
VITE_GA_MEASUREMENT_ID=

# Optional: name column in the leads table. This project uses full_name.
VITE_LEADS_NAME_COLUMN=full_name
